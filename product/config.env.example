# Copy to a private file outside Git. Never put a real secret here.
TABLEKEEPER_MODE=production
TABLEKEEPER_PUBLIC_ORIGIN=https://proofline-tablekeeper.web.app
TABLEKEEPER_STORAGE=firestore
GOOGLE_CLOUD_PROJECT=replace-with-project-id
TABLEKEEPER_COLLECTION=tablekeeper
TABLEKEEPER_DATABASE=(default)
TABLEKEEPER_PUBLIC_DEMO=0
# Supply a protected setup-secret file or Secret Manager environment binding.
# TABLEKEEPER_SETUP_SECRET_FILE=/private/setup-secret
